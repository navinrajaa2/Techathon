# Render Environment Variables Configuration Template
# Copy these key-value pairs into your Render Web Service Environment Settings

# Server Port (Render sets process.env.PORT automatically, default 10000)
PORT=10000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster.mongodb.net/pathcraft_ai?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Allowed Frontend Client URL for CORS Security (Optional, defaults to * if left empty)
# Example: https://pathcraft-ai.onrender.com or https://your-app.vercel.app
CLIENT_URL=
